<Bindings>
	<Binding name="GAMEPADSPEAK_D0" hidden="true">GamepadSpeakTransport.Input("0")</Binding>
	<Binding name="GAMEPADSPEAK_D1" hidden="true">GamepadSpeakTransport.Input("1")</Binding>
	<Binding name="GAMEPADSPEAK_D2" hidden="true">GamepadSpeakTransport.Input("2")</Binding>
	<Binding name="GAMEPADSPEAK_D3" hidden="true">GamepadSpeakTransport.Input("3")</Binding>
	<Binding name="GAMEPADSPEAK_START" hidden="true">GamepadSpeakTransport.Input("start")</Binding>
	<Binding name="GAMEPADSPEAK_SEND" hidden="true">GamepadSpeakTransport.Input("send")</Binding>
	<!-- Legacy bit names kept so an older helper still maps, if briefly mismatched. -->
	<Binding name="GAMEPADSPEAK_ZERO" hidden="true">GamepadSpeakTransport.Input("0")</Binding>
	<Binding name="GAMEPADSPEAK_ONE" hidden="true">GamepadSpeakTransport.Input("1")</Binding>
	<Binding name="GAMEPADSPEAK_OPENCHAT" category="ADDONS" header="GAMEPADSPEAK_HEADER">
		GamepadSpeak_OpenChat()
	</Binding>
</Bindings>
