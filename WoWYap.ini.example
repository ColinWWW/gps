# Optional settings. Double-click Start.cmd — you usually do not need this file.
# If WoW is not under Program Files, set wow_dir to your _classic_beta_ folder.

[wowyap]
# wow_dir = D:\MYFAVORITEMONSTERGAME\World of Warcraft\_classic_beta_
# model = base.en
# For faster recognition with potentially lower accuracy, use model = tiny.en
# silent = false

# packet_delay = 0.0025
# key_hold = 0
# If WoW drops batched packets, try key_hold = 0.001 and packet_delay = 0.004
